  m_Script: {fileID: 11500000, guid: eb236693f9dbe47498f4dd7ccccbfbf3, type: 3}
  m_Name: Q18
  m_EditorClassIdentifier: Assembly-CSharp::InterviewQuestionData
  question: "Draw Call l\xE0 g\xEC? C\xE1ch gi\u1EA3m Draw Call trong Unity?"
  choices:
  - text: "D\xF9ng Batching v\xE0 GPU Instancing \u0111\u1EC3 g\u1ED9p nhi\u1EC1u
      mesh c\xF9ng material. Occlusion Culling tr\xE1nh render object b\u1ECB che."
    score: 2
    feedbackHint: "Bi\u1EBFt 3 k\u1EF9 thu\u1EADt ch\xEDnh."
  - text: "C\u1EA7n gi\u1EA3m s\u1ED1 polygon v\xE0 texture size \u0111\u1EC3 t\u0103ng
      performance."
    score: 1
    feedbackHint: "Nh\u1EA7m Draw Call v\u1EDBi polygon count."
  - text: "Draw Call l\xE0 l\u1EC7nh CPU g\u1EEDi GPU \u0111\u1EC3 render m\u1ED9t
      mesh. Nhi\u1EC1u Draw Call = CPU overhead. Gi\u1EA3m b\u1EB1ng: GPU Instancing
      (c\xF9ng mesh+material), Static/Dynamic Batching, SRP Batcher (URP \u2014 gi\u1EA3m
      state change), Occlusion Culling, LOD Group, Atlas texture \u0111\u1EC3 gi\u1EA3m
      material kh\xE1c nhau."
    score: 3
    feedbackHint: "Li\u1EC7t k\xEA \u0111\u1EE7 techniques, bi\u1EBFt SRP Batcher
      trong URP."
  category: URP
