  m_Script: {fileID: 11500000, guid: eb236693f9dbe47498f4dd7ccccbfbf3, type: 3}
  m_Name: Q27
  m_EditorClassIdentifier: Assembly-CSharp::InterviewQuestionData
  question: "Data-Driven Design trong game l\xE0 g\xEC? V\xED d\u1EE5 th\u1EF1c t\u1EBF?"
  choices:
  - text: "Data-Driven: t\xE1ch data kh\u1ECFi logic, designer thay \u0111\u1ED5i
      game m\xE0 kh\xF4ng c\u1EA7n code. Implement b\u1EB1ng ScriptableObject (item
      stats, enemy config, skill data), JSON/CSV cho balance sheet, Google Sheets
      sync pipeline. L\u1EE3i \xEDch: designer kh\xF4ng c\u1EA7n programmer, d\u1EC5
      balance, A/B testing. Nerocortex/ChatGPT c\xF3 th\u1EC3 generate data dynamically."
    score: 3
    feedbackHint: "Bi\u1EBFt tool pipeline, designer workflow, v\xE0 dynamic data
      generation."
  - text: "T\xF4i hardcode stats trong script, khi c\u1EA7n \u0111\u1ED5i th\xEC
      s\u1EEDa code."
    score: 1
    feedbackHint: "Hardcoding stats l\xE0 anti-pattern trong game dev."
  - text: "D\xF9ng ScriptableObject \u0111\u1EC3 l\u01B0u config c\u1EE7a item, enemy
      - designer ch\u1EC9nh trong Inspector kh\xF4ng c\u1EA7n code."
    score: 2
    feedbackHint: "Bi\u1EBFt ScriptableObject approach."
  category: Architecture
