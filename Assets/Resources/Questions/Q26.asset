  m_Script: {fileID: 11500000, guid: eb236693f9dbe47498f4dd7ccccbfbf3, type: 3}
  m_Name: Q26
  m_EditorClassIdentifier: Assembly-CSharp::InterviewQuestionData
  question: "L\xE0m th\u1EBF n\xE0o \u0111\u1EC3 qu\u1EA3n l\xFD Scene trong game
    l\u1EDBn? Additive Scene Loading?"
  choices:
  - text: "D\xF9ng LoadSceneAsync \u0111\u1EC3 kh\xF4ng block main thread. C\xF3
      th\u1EC3 d\xF9ng Additive \u0111\u1EC3 gi\u1EEF scene c\u0169."
    score: 2
    feedbackHint: "Bi\u1EBFt async loading nh\u01B0ng ch\u01B0a bi\u1EBFt workflow
      th\u1EF1c t\u1EBF."
  - text: "D\xF9ng SceneManager.LoadScene, c\xF3 loading screen b\u1EB1ng coroutine."
    score: 1
    feedbackHint: "Bi\u1EBFt c\u01A1 b\u1EA3n nh\u01B0ng synchronous loading s\u1EBD
      freeze frame."
  - text: "LoadSceneAsync Additive cho ph\xE9p load scene ch\u1ED3ng nhau - t\u1ED1t
      cho streaming open world, UI scene ri\xEAng, persistent manager scene. SceneManager.SetActiveScene
      \u0111\u1EC3 ch\u1ECDn scene active. D\xF9ng Addressables cho async scene loading
      v\u1EDBi memory control. Pattern: Bootstrap scene load manager scene -> load
      game scene additively."
    score: 3
    feedbackHint: "Bi\u1EBFt additive loading, Addressables, bootstrap pattern."
  category: Architecture
