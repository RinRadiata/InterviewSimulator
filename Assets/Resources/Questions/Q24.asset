  m_Script: {fileID: 11500000, guid: eb236693f9dbe47498f4dd7ccccbfbf3, type: 3}
  m_Name: Q24
  m_EditorClassIdentifier: Assembly-CSharp::InterviewQuestionData
  question: "State Machine pattern trong game - implement th\u1EBF n\xE0o? Khi n\xE0o
    d\xF9ng?"
  choices:
  - text: "D\xF9ng enum \u0111\u1EC3 track state, switch-case trong Update \u0111\u1EC3
      handle behavior. D\xF9ng cho player (idle, walk, attack, dead)."
    score: 2
    feedbackHint: "Bi\u1EBFt concept nh\u01B0ng enum-switch scale k\xE9m, kh\xF4ng
      object-oriented."
  - text: "D\xF9ng bool flag \u0111\u1EC3 check player action"
    score: 1
    feedbackHint: "Kh\xF4ng bi\u1EBFt State Machine pattern, s\u1EBD t\u1EA1o \"spaghetti
      code\"."
  - text: "State Machine t\u1ED1t cho entity c\xF3 behavior thay \u0111\u1ED5i r\xF5
      r\xE0ng (AI, Player, UI flow). Implement: interface IState v\u1EDBi Enter/Update/Exit,
      StateContext l\u01B0u currentState v\xE0 chuy\u1EC3n state. Hierarchical State
      Machine cho complex AI. T\u1ED1t h\u01A1n d\xF9ng bool/enum flag r\u1EA3i r\xE1c.
      Unity Animator l\xE0 state machine cho animation."
    score: 3
    feedbackHint: "Bi\u1EBFt interface-based implementation v\xE0 Hierarchical FSM."
  category: Architecture
