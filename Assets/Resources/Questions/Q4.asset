  m_Script: {fileID: 11500000, guid: eb236693f9dbe47498f4dd7ccccbfbf3, type: 3}
  m_Name: Q4
  m_EditorClassIdentifier: Assembly-CSharp::InterviewQuestionData
  question: "Coroutine trong Unity ho\u1EA1t \u0111\u1ED9ng nh\u01B0 th\u1EBF n\xE0o?
    C\xF3 ph\u1EA3i l\xE0 multi-threading kh\xF4ng?"
  choices:
  - text: "Coroutine ch\u1EA1y song song v\u1EDBi code ch\xEDnh, gi\u1ED1ng nh\u01B0
      async/await."
    score: 1
    feedbackHint: "Nh\u1EA7m l\u1EABn coroutine v\u1EDBi threading."
  - text: "Coroutine kh\xF4ng ph\u1EA3i multi-threading,  n\xF3 ch\u1EA1y tr\xEAn
      main thread nh\u01B0ng c\xF3 th\u1EC3 't\u1EA1m d\u1EEBng' b\u1EB1ng \"yield\".
      Unity d\xF9ng IEnumerator \u0111\u1EC3 l\u01B0u tr\u1EA1ng th\xE1i, resume
      m\u1ED7i frame ho\u1EB7c sau th\u1EDDi gian ch\u1EDD. D\xF9ng t\u1ED1t cho
      animation, delay, async sequence nh\u01B0ng kh\xF4ng n\xEAn d\xF9ng cho heavy
      computation."
    score: 3
    feedbackHint: "Hi\u1EC3u \u0111\xFAng b\u1EA3n ch\u1EA5t single-thread cooperative,
      bi\u1EBFt gi\u1EDBi h\u1EA1n."
  - text: "Coroutine l\xE0 c\xE1ch Unity l\xE0m vi\u1EC7c b\u1EA5t \u0111\u1ED3ng
      b\u1ED9, d\xF9ng yield return \u0111\u1EC3 ch\u1EDD. Kh\xF4ng ph\u1EA3i thread
      m\u1EDBi."
    score: 1
    feedbackHint: "\u0110\xFAng nh\u01B0ng ch\u01B0a gi\u1EA3i th\xEDch c\u01A1 ch\u1EBF
      IEnumerator."
  category: C#
