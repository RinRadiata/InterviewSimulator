  m_Script: {fileID: 11500000, guid: eb236693f9dbe47498f4dd7ccccbfbf3, type: 3}
  m_Name: Q22
  m_EditorClassIdentifier: Assembly-CSharp::InterviewQuestionData
  question: 'Lighting trong Unity: Baked vs Realtime vs Mixed lighting?'
  choices:
  - text: "Baked nhanh h\u01A1n runtime nh\u01B0ng ch\u1EC9 cho static object. Realtime
      flexible h\u01A1n nh\u01B0ng t\u1ED1n performance."
    score: 2
    feedbackHint: "Hi\u1EC3u trade-off c\u01A1 b\u1EA3n nh\u01B0ng ch\u01B0a bi\u1EBFt
      Mixed v\xE0 Light Probe."
  - text: "Realtime: t\xEDnh m\u1ED7i frame, t\u1ED1n GPU, h\u1ED7 tr\u1EE3 dynamic
      shadow. Baked: t\xEDnh tr\u01B0\u1EDBc v\xE0o lightmap, mi\u1EC5n ph\xED runtime
      nh\u01B0ng static only. Mixed: shadow t\u1EEB static object baked (Shadowmask
      mode), dynamic object v\u1EABn receive realtime shadow. Progressive GPU Lightmapper
      nhanh h\u01A1n CPU. Light Probe cho dynamic object nh\u1EADn indirect baked
      lighting."
    score: 3
    feedbackHint: "Bi\u1EBFt c\u1EA3 3 mode v\xE0 Light Probe - production knowledge."
  - text: "T\xF4i d\xF9ng Directional Light realtime cho \u0111\u01A1n gi\u1EA3n."
    score: 1
    feedbackHint: "Ch\u01B0a bi\u1EBFt optimization lighting."
  category: URP
