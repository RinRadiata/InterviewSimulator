  m_Script: {fileID: 11500000, guid: eb236693f9dbe47498f4dd7ccccbfbf3, type: 3}
  m_Name: Q15
  m_EditorClassIdentifier: Assembly-CSharp::InterviewQuestionData
  question: "B\u1EA1n hi\u1EC3u nh\u01B0 th\u1EBF n\xE0o v\u1EC1 Serialization trong
    Unity: [SerializeField], [HideInInspector], JsonUtility?"
  choices:
  - text: "D\xF9ng public field cho Inspector v\xE0 PlayerPrefs \u0111\u1EC3 l\u01B0u
      data"
    score: 1
    feedbackHint: "D\xF9ng anti-pattern (public field), kh\xF4ng bi\u1EBFt SerializeField."
  - text: "[SerializeField] cho ph\xE9p private field hi\u1EC7n trong Inspector.
      JsonUtility d\xF9ng \u0111\u1EC3 convert object sang JSON."
    score: 2
    feedbackHint: 
  - text: "[SerializeField] serialize private field ra Inspector v\xE0 v\xE0o file.
      [HideInInspector] serialize nh\u01B0ng \u1EA9n kh\u1ECFi Inspector. JsonUtility
      nhanh nh\u01B0ng gi\u1EDBi h\u1EA1n: kh\xF4ng support Dictionary, interface,
      generic class. D\xF9ng Newtonsoft.Json cho complex data. PlayerPrefs ch\u1EC9
      cho primitive. ScriptableObject t\u1ED1t nh\u1EA5t cho game config."
    score: 3
    feedbackHint: "Bi\u1EBFt r\xF5 gi\u1EDBi h\u1EA1n c\u1EE7a JsonUtility v\xE0
      alternatives."
  category: Unity
